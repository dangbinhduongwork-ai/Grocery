# =============================================================================
# GroceryHub — Environment Configuration Template (.env.example)
# =============================================================================
# Copy this file to `.env` for local development or server deployment:
#   cp .env.example .env
#
# SECURITY RULES:
# - Never commit `.env` or real production credentials to Git.
# - Replace all `CHANGE_ME_*` placeholders before deploying to any shared or
#   production environment.
# =============================================================================

# --- Runtime Environment ---
# Values: Development | Staging | Production
ASPNETCORE_ENVIRONMENT=Development
# Public base URL of the storefront & gateway (DEC-018: grocery.dangbinhduong.io.vn in Production)
App__PublicBaseUrl=http://localhost:8080
Serilog__MinimumLevel=Information

# --- Host Published Ports ---
# In production with docker-compose.yml, only WEB_PORT is exposed to host/reverse proxy.
# SQLSERVER_PORT, API_PORT, and MAILPIT_* are only exposed via docker-compose.override.yml in dev.
WEB_PORT=8080
SQLSERVER_PORT=1433
API_PORT=5000
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# --- SQL Server Container / Cloud Database (DEC-010, DEC-018) ---
# Edition options for MSSQL_PID:
#   - Developer: For non-production development/testing ONLY (strictly not licensed for production).
#   - Express: Free commercial license (up to 10 GB DB limit, 1.4 GB RAM, 4 cores).
#   - Standard / Enterprise: Licensed editions.
#   - Cloud Managed: Set ConnectionStrings__DefaultConnection directly (e.g. Azure SQL / AWS RDS).
MSSQL_PID=Developer
MSSQL_SA_PASSWORD=CHANGE_ME_Strong_Sql_Password_2026!
ConnectionStrings__DefaultConnection=Server=sqlserver,1433;Database=GroceryHub;User Id=sa;Password=CHANGE_ME_Strong_Sql_Password_2026!;TrustServerCertificate=True;Encrypt=True

# --- JWT & Authentication Security (ADR-003, DEC-015) ---
Jwt__Issuer=https://grocery.dangbinhduong.io.vn
Jwt__Audience=https://grocery.dangbinhduong.io.vn
# Must be at least 32 random bytes (256 bits) for HMAC-SHA256 signing (generate via `openssl rand -hex 32`)
Jwt__SigningKey=CHANGE_ME_32_BYTES_MINIMUM_SECRET_KEY_PLACEHOLDER

# --- SePay VietQR & Webhook Integration (DEC-006, Spec 11) ---
# Environment: Sandbox | Production
SePay__Environment=Sandbox
SePay__AccountNumber=0000000000
SePay__BankShortName=MBBank
SePay__AccountName=CONG TY TNHH GROCERYHUB
SePay__PaymentCodePrefix=GH
# AuthMode: Hmac | ApiKey
SePay__Webhook__AuthMode=Hmac
SePay__Webhook__HmacSecret=CHANGE_ME_SEPAY_HMAC_SECRET_PLACEHOLDER
# Previous secret during zero-downtime rotation overlap (optional)
SePay__Webhook__HmacSecretPrevious=
SePay__Webhook__ApiKey=CHANGE_ME_SEPAY_APIKEY_PLACEHOLDER
SePay__Api__BaseUrl=https://userapi-sandbox.sepay.vn/v2
SePay__Api__Token=CHANGE_ME_SEPAY_API_TOKEN_PLACEHOLDER

# --- Payments & Checkout Policy (DEC-007) ---
# Maximum order total eligible for Cash on Delivery (VND integer)
Payments__CodMaxAmount=2000000

# --- SMTP / Email Provider (DEC-018) ---
# For local dev/staging: uses containerized Mailpit
# For production: configure transactional email provider (Resend, SendGrid, Brevo, AWS SES)
Smtp__Host=mailpit
Smtp__Port=1025
Smtp__User=
Smtp__Password=
Smtp__From=no-reply@grocery.dangbinhduong.io.vn

# --- Storage & CORS ---
Storage__ImagesPath=/app/var/product-images
# CORS is only needed when frontend and API are hosted on different origins during local dev.
Cors__AllowedOrigins=http://localhost:5173,http://localhost:8080

# --- Initial Admin Account Seeding (First-Run / Dev Only) ---
Seed__AdminEmail=admin@groceryhub.vn
Seed__AdminPassword=CHANGE_ME_Admin_Seed_Password_2026!
