# =============================================================================
# GroceryHub — Environment Configuration Template (.env.example)
# =============================================================================
# Copy this file to `.env` for local development:
#   cp .env.example .env
#
# SECURITY WARNING:
# - Never commit `.env` or real credentials to Git.
# - Replace all `CHANGE_ME_*` placeholders before running in any shared or
#   production environment.
# =============================================================================

# --- Runtime Environment ---
ASPNETCORE_ENVIRONMENT=Development
App__PublicBaseUrl=http://localhost:5173
Serilog__MinimumLevel=Information

# --- Host Ports (Local Development Override) ---
SQLSERVER_PORT=1433
API_PORT=8080
WEB_PORT=5173
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# --- SQL Server Container & Connection String ---
# Edition (DEC-010):
#   - Use `Developer` for local development/testing only (not licensed for production).
#   - Use `Express` in Production (free commercial license, 10 GB database limit),
#     or a licensed Standard/Enterprise/managed SQL edition.
MSSQL_PID=Developer
MSSQL_SA_PASSWORD=CHANGE_ME_Strong_Sql_Password_2026!
ConnectionStrings__DefaultConnection=Server=localhost,1433;Database=GroceryHub;User Id=sa;Password=CHANGE_ME_Strong_Sql_Password_2026!;TrustServerCertificate=True;Encrypt=True

# --- JWT & Authentication (ADR-003) ---
Jwt__Issuer=https://groceryhub.local
Jwt__Audience=https://groceryhub.local
# Must be at least 32 random bytes (256 bits) for HMAC-SHA256 signing
Jwt__SigningKey=CHANGE_ME_32_BYTES_MINIMUM_SECRET_KEY_PLACEHOLDER

# --- SePay VietQR & Webhook Integration (DEC-006, Spec 11) ---
# Environment: Sandbox | Production
SePay__Environment=Sandbox
SePay__AccountNumber=0000000000
SePay__BankShortName=MBBank
SePay__AccountName=CONG TY TNHH GROCERYHUB
SePay__PaymentCodePrefix=GH
# AuthMode: Hmac | ApiKey
SePay__Webhook__AuthMode=Hmac
SePay__Webhook__HmacSecret=CHANGE_ME_SEPAY_HMAC_SECRET_PLACEHOLDER
# Previous secret during zero-downtime rotation overlap (optional)
SePay__Webhook__HmacSecretPrevious=
SePay__Webhook__ApiKey=CHANGE_ME_SEPAY_APIKEY_PLACEHOLDER
SePay__Api__BaseUrl=https://userapi-sandbox.sepay.vn/v2
SePay__Api__Token=CHANGE_ME_SEPAY_API_TOKEN_PLACEHOLDER

# --- Payments & Checkout Policy (DEC-007) ---
# Maximum order total eligible for Cash on Delivery (VND integer)
Payments__CodMaxAmount=2000000

# --- SMTP / Email (Local Mailpit by default) ---
Smtp__Host=localhost
Smtp__Port=1025
Smtp__User=
Smtp__Password=
Smtp__From=no-reply@groceryhub.local

# --- Storage & CORS ---
Storage__ImagesPath=./var/product-images
Cors__AllowedOrigins=http://localhost:5173

# --- Initial Admin Seeding (First-Run / Dev Only) ---
Seed__AdminEmail=admin@groceryhub.vn
Seed__AdminPassword=CHANGE_ME_Admin_Seed_Password_2026!
