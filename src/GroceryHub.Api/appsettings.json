{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost,1433;Database=GroceryHub;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "GroceryHub": {
    "ServiceName": "GroceryHub.Api",
    "EnvironmentName": "Production",
    "Version": "1.0.0"
  },
  "RateLimiting": {
    "AuthPermitLimitPerMinute": 5,
    "CheckoutPermitLimitPerMinute": 10,
    "PublicReadPermitLimitPerMinute": 120
  },
  "AllowedHosts": "*"
}
